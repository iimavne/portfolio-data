# Modèle des variables d'environnement. Copier ce fichier en ".env" et remplir les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore). En ligne, ces mêmes variables
# se renseignent dans Vercel : Settings > Environment Variables.

# Formulaire de contact : clé d'accès Web3Forms (https://web3forms.com).
# Les messages sont envoyés à l'adresse associée à cette clé, jamais affichée sur le site.
PUBLIC_WEB3FORMS_KEY=

# ----- Keystatic, mode GitHub -----
# Les 4 variables ci-dessous sont écrites automatiquement dans .env par Keystatic
# lors de la création de la GitHub App (page /keystatic/setup), puis à recopier dans Vercel.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Local uniquement (jamais dans Vercel) : "github" pour utiliser le mode GitHub
# avec `npm run dev` (création de la GitHub App, tests). Vide ou absent = mode local.
PUBLIC_KEYSTATIC_STORAGE=
