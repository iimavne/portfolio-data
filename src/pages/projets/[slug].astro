---
// Page d'un projet : /projets/<nom-du-fichier>
// Astro génère une page par fichier de src/content/projets/ (voir getStaticPaths).
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { categories } from '../../data/projets';
import { getProjets, numero, resume, titre, type Projet } from '../../lib/projets';
import { defaultLang, localizePath, useTranslations } from '../../i18n/ui';
import '../../styles/prose.css';

// Liste des pages à générer : une par projet, avec ses voisins pour la navigation
export async function getStaticPaths() {
  const projets = await getProjets();
  return projets.map((projet, index) => ({
    params: { slug: projet.id },
    props: { projet, index, precedent: projets[index - 1], suivant: projets[index + 1] },
  }));
}

interface Props {
  projet: Projet;
  index: number;
  precedent?: Projet;
  suivant?: Projet;
}

const { projet, index, precedent, suivant } = Astro.props;
const { data } = projet;
const lang = defaultLang;
const t = useTranslations(lang);

// Contenu Markdoc transformé en HTML + liste de ses titres
const { Content, headings } = await render(projet);
const sommaire = headings.filter((h) => h.depth === 2); // seulement les titres "##"

// Métadonnées : on n'affiche que celles qui sont remplies
const metas = [
  { label: t('project.course'), valeur: data.cours },
  { label: t('project.period'), valeur: data.periode },
  { label: t('project.tools'), valeur: data.outils.join(', ') },
  { label: t('project.work'), valeur: data.travail && t(`work.${data.travail}`) },
].filter((meta) => meta.valeur);

// En bas de page : le projet suivant, ou le précédent s'il n'y en a pas après
const autre = suivant ?? precedent;
const autreLabel = suivant ? t('project.next') : t('project.prev');
---

<BaseLayout title={titre(projet, lang)} description={resume(projet, lang)} lang={lang}>
  <ProjectNav slot="header" lang={lang} />

  <article class="container">
    <!-- ----- En-tête ----- -->
    <header class="head">
      <p class="head__kicker">
        <span>{t('project.label')} {numero(index)} · {categories[data.categorie][lang]}</span>
        <StatusBadge statut={data.statut} lang={lang} />
      </p>
      <h1 class="head__title">{titre(projet, lang)}</h1>
      <p class="head__resume">{resume(projet, lang)}</p>

      {(data.lienGithub || data.fichier) && (
        <div class="head__actions">
          {data.lienGithub && (
            <a class="btn btn--accent btn--lg" href={data.lienGithub} target="_blank" rel="noopener noreferrer">
              {t('project.github')}<span class="sr-only"> {t('contact.newTab')}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </a>
          )}
          {data.fichier && (
            <a class="btn btn--lg" href={data.fichier} download>
              {t('project.file')}
            </a>
          )}
        </div>
      )}
    </header>

    <!-- ----- Métadonnées ----- -->
    {metas.length > 0 && (
      <dl class="metas">
        {metas.map((meta) => (
          <div>
            <dt>{meta.label}</dt>
            <dd>{meta.valeur}</dd>
          </div>
        ))}
      </dl>
    )}

    <!-- ----- Sommaire + contenu ----- -->
    <div class="body">
      {sommaire.length > 0 && (
        <nav class="toc" aria-labelledby="toc-titre">
          <p class="toc__title" id="toc-titre">{t('project.toc')}</p>
          <ul>
            {sommaire.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <!-- ----- Projet suivant / précédent ----- -->
  {autre && (
    <div class="container">
      <a class="other" href={localizePath(`/projets/${autre.id}`, lang)}>
        <span>
          <span class="other__label">{autreLabel}</span>
          <span class="other__title">{titre(autre, lang)}</span>
        </span>
        <span class="other__arrow" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>
  )}
</BaseLayout>

<script>
  // Sommaire : surligne la section en cours de lecture
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const titres = liens.map((lien) => document.getElementById(decodeURIComponent(lien.hash.slice(1))));

  function majSommaire() {
    // La section active est le dernier titre déjà passé sous le haut de l'écran
    let actif = 0;
    titres.forEach((titre, i) => {
      if (titre && titre.getBoundingClientRect().top < 160) actif = i;
    });
    liens.forEach((lien, i) => {
      if (i === actif) lien.setAttribute('aria-current', 'true');
      else lien.removeAttribute('aria-current');
    });
  }

  if (liens.length) {
    majSommaire();
    window.addEventListener('scroll', majSommaire, { passive: true });
  }
</script>

<style>
  /* ----- En-tête ----- */
  .head {
    max-width: 42rem;
    padding-top: 4.5rem;
  }

  .head__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
  }

  .head__title {
    margin-top: 1.25rem;
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .head__resume {
    margin-top: 1.75rem;
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* ----- Métadonnées : 4 colonnes, puis 2 ----- */
  .metas {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem 2rem;
    margin-top: 2.75rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--border);
  }

  .metas dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .metas dd {
    margin: 0.3rem 0 0;
    font-size: 1.0625rem;
  }

  /* ----- Sommaire (colonne collante) + contenu ----- */
  .body {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 3rem;
    margin-top: 5.5rem;
  }

  .toc {
    position: sticky;
    top: 2rem;
    align-self: start; /* nécessaire pour que sticky fonctionne dans une grille */
  }

  .toc__title {
    margin-bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .toc ul {
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: block;
    padding: 0.5rem 0 0.5rem 0.9rem;
    border-left: 2px solid transparent;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    transition: color 0.15s;
  }

  .toc a:hover {
    color: var(--text);
  }

  /* Section en cours : barre verte à gauche */
  .toc a[aria-current] {
    border-left-color: var(--accent);
    color: var(--text);
  }

  /* ----- Projet suivant / précédent ----- */
  .other {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-top: 6rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .other__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .other__title {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1rem + 2.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .other__arrow {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform 0.15s;
  }

  .other:hover .other__arrow {
    transform: translateX(4px);
  }

  /* ----- Tablette et mobile ----- */
  @media (max-width: 900px) {
    .body {
      /* minmax(0, …) : la colonne peut rétrécir sous la largeur d'une longue ligne de code */
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      margin-top: 3.5rem;
    }

    /* Le sommaire passe au-dessus du contenu, sans rester collé */
    .toc {
      position: static;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 700px) {
    .head {
      padding-top: 2.5rem;
    }

    .metas {
      grid-template-columns: repeat(2, 1fr);
    }

    .other__arrow {
      width: 3rem;
      height: 3rem;
    }
  }
</style>
