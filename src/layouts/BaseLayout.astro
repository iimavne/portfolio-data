---
// Squelette commun à toutes les pages : <head>, nav, contenu, footer.
// Utilisation dans une page :
//   <BaseLayout title="Mon titre">  ...contenu...  </BaseLayout>
// Pour remplacer la nav : <MonEnTete slot="header" /> dans le contenu.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { cheminSansLangue, defaultLang, languages, localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title?: string;        // titre de l'onglet (sinon : nom seul)
  description?: string;  // résumé pour Google et les partages
  lang?: Lang;           // 'fr' par défaut
}

const { title, description, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} · ${site.name}` : site.name;
const pageDescription = description ?? t('site.description');

// Versions de cette page dans chaque langue (balises hreflang pour Google).
// Astro.site vient de l'option `site` de astro.config.mjs.
const chemin = cheminSansLangue(Astro.url.pathname);
const versions = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: Astro.site ? new URL(localizePath(chemin, code), Astro.site).href : undefined,
}));
const adresseCanonique = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0d0f12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Adresse officielle de la page, et ses versions FR / EN -->
    {adresseCanonique && <link rel="canonical" href={adresseCanonique} />}
    {versions.map((v) => v.href && <link rel="alternate" hreflang={v.code} href={v.href} />)}
    {versions[0].href && <link rel="alternate" hreflang="x-default" href={versions[0].href} />}

    <!-- Polices Google : Bricolage Grotesque (titres), DM Sans (texte), JetBrains Mono (labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=DM+Sans:opsz,wght@9..40,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <!-- En-tête : la nav du site, sauf si la page fournit le sien (slot="header") -->
    <slot name="header">
      <Nav lang={lang} />
    </slot>
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
