---
// Squelette commun à toutes les pages : <head>, nav, contenu, footer.
// Utilisation dans une page :
//   <BaseLayout title="Mon titre">  ...contenu...  </BaseLayout>
// Pour remplacer la nav : <MonEnTete slot="header" /> dans le contenu.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { cheminSansLangue, defaultLang, languages, localizePath, useTranslations, type Lang } from '../i18n/ui';

interface ImagePartage {
  src: string;           // chemin de l'image sur le site
  width: number;         // taille réelle, en pixels
  height: number;
}

interface Props {
  title?: string;        // titre de l'onglet (sinon : nom seul)
  description?: string;  // résumé pour Google et les partages
  lang?: Lang;           // 'fr' par défaut
  image?: ImagePartage;  // image d'aperçu au partage (sinon : public/og-<langue>.png)
  type?: 'website' | 'article'; // 'article' pour une page projet
}

const { title, description, lang = defaultLang, image, type = 'website' } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} · ${site.name}` : site.name;
const pageDescription = description ?? t('site.description');

// Versions de cette page dans chaque langue (balises hreflang pour Google).
// Astro.site vient de l'option `site` de astro.config.mjs.
const chemin = cheminSansLangue(Astro.url.pathname);
const versions = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: Astro.site ? new URL(localizePath(chemin, code), Astro.site).href : undefined,
}));
const adresseCanonique = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// Image d'aperçu (LinkedIn, WhatsApp...) : l'adresse doit être complète, d'où Astro.site.
// Les images générales se régénèrent avec scripts/apercu-partage.html.
const apercu = image ?? { src: `/og-${lang}.png`, width: 1200, height: 630 };
const imagePartage = Astro.site ? new URL(apercu.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0d0f12" />
    <!-- Icônes : ICO pour les anciens navigateurs, SVG pour les récents, PNG pour l'écran d'accueil iPhone -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Adresse officielle de la page, et ses versions FR / EN -->
    {adresseCanonique && <link rel="canonical" href={adresseCanonique} />}
    {versions.map((v) => v.href && <link rel="alternate" hreflang={v.code} href={v.href} />)}
    {versions[0].href && <link rel="alternate" hreflang="x-default" href={versions[0].href} />}

    <!-- Aperçu quand le lien est partagé (Open Graph : LinkedIn, WhatsApp, Slack... ; Twitter/X) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    {adresseCanonique && <meta property="og:url" content={adresseCanonique} />}
    {imagePartage && <meta property="og:image" content={imagePartage} />}
    {imagePartage && <meta property="og:image:width" content={String(apercu.width)} />}
    {imagePartage && <meta property="og:image:height" content={String(apercu.height)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Polices Google : Bricolage Grotesque (titres), DM Sans (texte), JetBrains Mono (labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=DM+Sans:opsz,wght@9..40,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <!-- En-tête : la nav du site, sauf si la page fournit le sien (slot="header") -->
    <slot name="header">
      <Nav lang={lang} />
    </slot>
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
