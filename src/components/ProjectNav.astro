---
// En-tête simplifié des pages projet : retour aux projets à gauche, nom + thème + langue à droite.
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="container project-nav">
  <a class="project-nav__back" href={localizePath('/#projets', lang)}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
    {t('project.back')}
  </a>

  <div class="project-nav__right">
    <a class="project-nav__logo" href={localizePath('/', lang)}>
      {site.name}
      <span class="sr-only">, {t('nav.home')}</span>
    </a>
    <ThemeToggle lang={lang} />
    <LangSwitch lang={lang} />
  </div>
</header>

<style>
  .project-nav {
    max-width: 56rem; /* aligné sur la colonne de la page projet */
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: var(--nav-height);
  }

  .project-nav__back {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    color: var(--text-2);
    transition: color 0.15s;
  }

  .project-nav__back:hover {
    color: var(--text);
  }

  .project-nav__right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .project-nav__logo {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
</style>
