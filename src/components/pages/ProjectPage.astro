---
// Page complète d'un projet, dans la langue demandée. Utilisée par
// src/pages/projets/[slug].astro (FR) et src/pages/en/projets/[slug].astro (EN).
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectNav from '../ProjectNav.astro';
import { contenu, contexte, lienProjet, resume, titre, type Projet } from '../../lib/projets';
import { useTranslations, type Lang } from '../../i18n/ui';
import '../../styles/prose.css';

interface Props {
  projet: Projet;
  suivant?: Projet;
  lang: Lang;
}

const { projet, suivant, lang } = Astro.props;
const { data } = projet;
const t = useTranslations(lang);

// Contenu Markdoc dans la bonne langue (le français si la version anglaise manque),
// transformé en HTML + liste de ses titres
const { source, traduit } = await contenu(projet, lang);
const { Content, headings } = await render(source);
const sommaire = headings.filter((h) => h.depth === 2); // seulement les titres "##"

// Métadonnées : on n'affiche que celles qui sont remplies
const metas = [
  { label: t('project.tools'), valeur: data.outils.join(', ') },
  { label: t('project.work'), valeur: t(`work.${data.travail}`) },
].filter((meta) => meta.valeur);

// Aperçu au partage : la couverture (si elle existe) recadrée au format 1,91:1 attendu par
// LinkedIn, en JPEG (accepté partout). Astro n'agrandit pas les images : on reste dans la
// taille d'origine. Sans couverture : l'image générale du site.
let apercu;
if (data.image) {
  const largeurApercu = Math.min(1200, data.image.width, Math.floor(data.image.height * 1.91));
  const image = await getImage({
    src: data.image,
    width: largeurApercu,
    height: Math.round(largeurApercu / 1.91),
    fit: 'cover',
    format: 'jpg',
  });
  apercu = { src: image.src, width: Number(image.attributes.width), height: Number(image.attributes.height) };
}
---

<BaseLayout
  title={titre(projet, lang)}
  description={resume(projet, lang)}
  lang={lang}
  image={apercu}
  type="article"
>
  <ProjectNav slot="header" lang={lang} />

  <article class="container">
    <!-- ----- En-tête ----- -->
    <header class="head">
      <p class="head__kicker">
        <span>{[data.domaine, contexte(projet, lang)].filter(Boolean).join(' · ')}</span>
      </p>
      <h1 class="head__title">{titre(projet, lang)}</h1>
      <p class="head__resume">{resume(projet, lang)}</p>
    </header>

    <!-- ----- Métadonnées ----- -->
    {metas.length > 0 && (
      <dl class="metas">
        {metas.map((meta) => (
          <div>
            <dt>{meta.label}</dt>
            <dd>{meta.valeur}</dd>
          </div>
        ))}
      </dl>
    )}

    <!-- ----- Sommaire + contenu ----- -->
    <div class="body">
      {sommaire.length > 0 && (
        <nav class="toc" aria-labelledby="toc-titre">
          <p class="toc__title" id="toc-titre">{t('project.toc')}</p>
          <ul>
            {sommaire.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div>
        <!-- Page anglaise sans traduction : on prévient, puis on affiche le français -->
        {!traduit && <p class="notice">{t('project.onlyFr')}</p>}
        <div class="prose" lang={traduit ? undefined : 'fr'}>
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- ----- Projet suivant (après le dernier : le premier) ----- -->
  {suivant && (
    <div class="container">
      <a class="other" href={lienProjet(suivant.id, lang)}>
        <span>
          <span class="other__label">{t('project.next')}</span>
          <span class="other__title">{titre(suivant, lang)}</span>
        </span>
        <span class="other__arrow" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>
  )}
</BaseLayout>

<script>
  // Sommaire : surligne la section en cours de lecture
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const titres = liens.map((lien) => document.getElementById(decodeURIComponent(lien.hash.slice(1))));

  function majSommaire() {
    // La section active est le dernier titre déjà passé sous le haut de l'écran
    let actif = 0;
    titres.forEach((titre, i) => {
      if (titre && titre.getBoundingClientRect().top < 160) actif = i;
    });
    liens.forEach((lien, i) => {
      if (i === actif) lien.setAttribute('aria-current', 'true');
      else lien.removeAttribute('aria-current');
    });
  }

  if (liens.length) {
    majSommaire();
    window.addEventListener('scroll', majSommaire, { passive: true });
  }
</script>

<style>
  /* ----- En-tête ----- */
  .head {
    max-width: 42rem;
    padding-top: 4.5rem;
  }

  .head__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
  }

  .head__title {
    margin-top: 1.25rem;
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .head__resume {
    margin-top: 1.75rem;
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  /* Résultat clé : encadré avec filet vert, comme "Je recherche" sur l'accueil */
  .head__result {
    margin-top: 1.75rem;
    padding: 0.9rem 1.15rem;
    border-left: 2px solid var(--accent);
    border-radius: 0 12px 12px 0;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .head__result-label {
    display: block;
    margin-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* ----- Métadonnées : jusqu'à 5 colonnes selon la place, puis 2 sur mobile ----- */
  .metas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.25rem 2rem;
    margin-top: 2.75rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--border);
  }

  .metas dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .metas dd {
    margin: 0.3rem 0 0;
    font-size: 1.0625rem;
  }

  /* ----- Sommaire (colonne collante) + contenu ----- */
  .body {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 3rem;
    margin-top: 5.5rem;
  }

  .toc {
    position: sticky;
    top: 2rem;
    align-self: start; /* nécessaire pour que sticky fonctionne dans une grille */
  }

  .toc__title {
    margin-bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .toc ul {
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: block;
    padding: 0.5rem 0 0.5rem 0.9rem;
    border-left: 2px solid transparent;
    font-size: 0.9375rem;
    color: var(--text-2);
    transition: color 0.15s;
  }

  .toc a:hover {
    color: var(--text);
  }

  /* Section en cours : barre verte à gauche */
  .toc a[aria-current] {
    border-left-color: var(--accent);
    color: var(--text);
  }

  /* Avertissement "page disponible en français seulement" */
  .notice {
    margin-bottom: 2.5rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    background: var(--surface);
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  /* ----- Projet suivant / précédent ----- */
  .other {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-top: 6rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .other__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .other__title {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1rem + 2.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .other__arrow {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform 0.15s;
  }

  .other:hover .other__arrow {
    transform: translateX(4px);
  }

  /* ----- Tablette et mobile ----- */
  @media (max-width: 900px) {
    .body {
      /* minmax(0, …) : la colonne peut rétrécir sous la largeur d'une longue ligne de code */
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      margin-top: 3.5rem;
    }

    /* Le sommaire passe au-dessus du contenu, sans rester collé */
    .toc {
      position: static;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 700px) {
    .head {
      padding-top: 2.5rem;
    }

    .metas {
      grid-template-columns: repeat(2, 1fr);
    }

    .other__arrow {
      width: 3rem;
      height: 3rem;
    }
  }
</style>
