---
// Accueil complet, dans la langue demandée. Utilisé par src/pages/index.astro (FR)
// et src/pages/en/index.astro (EN). Chaque section est dans src/components/home/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../home/Hero.astro';
import Projets from '../home/Projets.astro';
import Parcours from '../home/Parcours.astro';
import Contact from '../home/Contact.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<!-- Ordre pensé pour un recruteur : qui il est et ce qu'il cherche (hero), puis les preuves
     (projets), son parcours (formations, cours, compétences), puis le contact. -->
<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <Projets lang={lang} />
  <Parcours lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
