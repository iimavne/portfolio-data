---
// Accueil complet, dans la langue demandée. Utilisé par src/pages/index.astro (FR)
// et src/pages/en/index.astro (EN). Chaque section est dans src/components/home/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../home/Hero.astro';
import Progression from '../home/Progression.astro';
import Projets from '../home/Projets.astro';
import Outils from '../home/Outils.astro';
import APropos from '../home/APropos.astro';
import Contact from '../home/Contact.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <Progression lang={lang} />
  <Projets lang={lang} />
  <Outils lang={lang} />
  <APropos lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
