---
// Image du contenu d'un projet : ![texte alternatif](chemin "légende").
// Les images locales (déposées dans l'admin) sont optimisées par Astro ;
// la légende s'affiche sous l'image si elle est remplie.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  title?: string; // la légende
}

const { src, alt = '', title } = Astro.props;
---

<figure class="figure">
  {typeof src === 'string' ? (
    <img src={src} alt={alt} loading="lazy" />
  ) : (
    <Image src={src} alt={alt} widths={[640, 1000, 1400]} sizes="(max-width: 900px) 100vw, 46rem" />
  )}
  {title && <figcaption>{title}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: 1.75rem;
  }

  .figure :global(img) {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
