---
// Balise Markdoc {% requete %} : question, mots-clés, code SQL (le contenu), résultat.
interface Props {
  question: string;
  tags?: string;
  resultat?: string;
}

const { question, tags, resultat } = Astro.props;
---

<figure class="requete">
  <figcaption class="requete__head">
    <span class="requete__question">{question}</span>
    {tags && <span class="requete__tags">{tags}</span>}
  </figcaption>

  <!-- Le bloc de code écrit entre les balises -->
  <div class="requete__code">
    <slot />
  </div>

  {resultat && <p class="requete__result">{resultat}</p>}
</figure>

<style>
  .requete {
    margin-block: 1.25rem;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card-lg);
  }

  .requete__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }

  .requete__question {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text);
  }

  .requete__tags {
    flex-shrink: 0;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Le <pre> généré par Markdoc : on retire son style de bloc autonome */
  .requete__code :global(pre) {
    margin: 0;
    border: none;
    border-block: 1px solid var(--border);
    border-radius: 0;
  }

  .requete__result {
    margin: 0;
    padding: 0.85rem 1.25rem;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .requete__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
