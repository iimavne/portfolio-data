---
// Barre de navigation : nom à gauche, liens + langue + CV à droite.
// Sur mobile (< 760px), les liens se replient derrière un bouton "Menu".
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Les ancres pointent vers l'accueil, pour fonctionner aussi depuis une page projet
const links = [
  { href: localizePath('/#projets', lang), label: t('nav.projects') },
  { href: localizePath('/#parcours', lang), label: t('nav.journey') },
  { href: localizePath('/#contact', lang), label: t('nav.contact') },
];
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__logo" href={localizePath('/', lang)}>
      {site.name}
      <span class="sr-only">, {t('nav.home')}</span>
    </a>

    <button
      class="nav__toggle btn"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      {t('nav.menu')}
    </button>

    <div class="nav__menu" id="nav-menu">
      <nav aria-label={t('nav.label')}>
        <ul class="nav__links">
          {links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Thème clair / sombre et lien vers la même page dans l'autre langue,
           côte à côte (aussi dans le menu mobile) -->
      <div class="nav__boutons">
        <ThemeToggle lang={lang} />
        <LangSwitch lang={lang} />
      </div>

      <!-- Bouton CV : affiché seulement si un PDF a été déposé dans l'admin -->
      {site.cv && (
        <a class="btn btn--accent nav__cv" href={site.cv} target="_blank" rel="noopener">
          {t('nav.cv')}<span class="sr-only"> {t('contact.newTab')}</span>
          <!-- Flèche de téléchargement -->
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v12M6 11l6 6 6-6M5 20h14" />
          </svg>
        </a>
      )}
    </div>
  </div>
</header>

<script>
  // Ouvre / ferme le menu mobile
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.querySelector<HTMLElement>('.nav__menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Referme le menu après un clic sur un lien d'ancre
    menu.querySelectorAll('nav a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Referme avec la touche Échap
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  /* Nav collante, avec un fond légèrement transparent et flouté */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--nav-height);
  }

  .nav__logo {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-right: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .nav__boutons {
    display: flex;
    gap: 0.5rem;
  }

  .nav__cv {
    padding: 0.55rem 1.1rem;
    font-size: 0.875rem;
  }

  .nav__links a {
    color: var(--text-2);
    font-size: 0.9375rem;
    transition: color 0.15s;
  }

  .nav__links a:hover {
    color: var(--text);
  }

  /* Bouton "Menu" : caché sur grand écran */
  .nav__toggle {
    display: none;
  }

  /* ----- Mobile ----- */
  @media (max-width: 760px) {
    .nav__toggle {
      display: inline-flex;
      padding: 0.5rem 1rem;
    }

    /* Le menu devient un panneau sous la barre, caché par défaut */
    .nav__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.25rem var(--gutter) 1.5rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    .nav__menu.is-open {
      display: flex;
    }

    .nav__links {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .nav__links a {
      font-size: 1.125rem;
    }
  }
</style>
