---
// Pilule FR | EN : renvoie vers la même page dans l'autre langue
// (ex. /projets/sql/ <-> /en/projets/sql/). La langue active est marquée aria-current.
import { cheminSansLangue, languages, localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const chemin = cheminSansLangue(Astro.url.pathname);
---

<ul class="lang" aria-label={t('nav.lang')}>
  {(Object.keys(languages) as Lang[]).map((code) => (
    <li>
      <a
        href={localizePath(chemin, code)}
        lang={code}
        hreflang={code}
        aria-current={code === lang ? 'true' : undefined}
      >
        <span aria-hidden="true">{code.toUpperCase()}</span>
        <span class="sr-only">{languages[code]}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .lang {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.1875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    list-style: none;
  }

  .lang a {
    display: block;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .lang a:hover {
    color: var(--text);
  }

  .lang a[aria-current] {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
