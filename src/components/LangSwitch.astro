---
// Bouton rond vers la même page dans l'autre langue : "EN" sur une page française,
// "FR" sur une page anglaise (ex. /projets/sql/ <-> /en/projects/sql/).
import { cheminTraduit, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const autre: Lang = lang === 'fr' ? 'en' : 'fr';
---

<a class="lang" href={cheminTraduit(Astro.url.pathname, autre)} lang={autre} hreflang={autre}>
  <span aria-hidden="true">{autre.toUpperCase()}</span>
  <span class="sr-only">{t('nav.otherLang')}</span>
</a>

<style>
  .lang {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.375rem;
    height: 2.375rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-2);
    transition: border-color 0.15s, color 0.15s;
  }

  .lang:hover {
    border-color: var(--muted);
    color: var(--text);
  }
</style>
