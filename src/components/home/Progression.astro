---
// Section "Progression" : roadmap des 6 étapes du master.
// Les étapes viennent de src/data/progression.ts ; compteurs et barre sont calculés.
import SectionHeading from '../SectionHeading.astro';
import StatusBadge from '../StatusBadge.astro';
import { etapes } from '../../data/progression';
import { getProjets, numero } from '../../lib/projets';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Compteurs de projets (affichés au-dessus de la barre)
const projets = await getProjets();
const nbProjetsTermines = projets.filter((p) => p.data.statut === 'termine').length;
const nbProjetsEnCours = projets.filter((p) => p.data.statut === 'en-cours').length;

// Barre : avancement dans les étapes. Une étape terminée compte pour 1, une en cours pour 1/2
const nbEtapesTerminees = etapes.filter((e) => e.statut === 'termine').length;
const nbEtapesEnCours = etapes.filter((e) => e.statut === 'en-cours').length;
const pourcentage = Math.round(((nbEtapesTerminees + nbEtapesEnCours / 2) / etapes.length) * 100);
---

<section id="progression" class="section container" aria-labelledby="progression-titre">
  <SectionHeading number="01" title={t('progress.title')} intro={t('progress.intro')} id="progression-titre">
    <div slot="aside" class="summary">
      <p class="summary__text">
        {nbProjetsTermines} {t('progress.projects')} {t('progress.done')} · {nbProjetsEnCours} {t('progress.inProgress')}
      </p>
      <!-- Barre d'avancement accessible (lue comme "42 %" par un lecteur d'écran) -->
      <div
        class="bar"
        role="progressbar"
        aria-label={t('progress.barLabel')}
        aria-valuenow={pourcentage}
        aria-valuemin="0"
        aria-valuemax="100"
      >
        <div class="bar__fill" style={`width: ${pourcentage}%`}></div>
      </div>
    </div>
  </SectionHeading>

  <!-- Liste ordonnée : l'ordre des étapes a un sens -->
  <ol class="steps">
    {etapes.map((etape, i) => (
      <li class:list={['step', `step--${etape.statut}`]}>
        <div class="step__top">
          <span class="step__num">{numero(i)}</span>
          <StatusBadge statut={etape.statut} lang={lang} />
        </div>
        <h3 class="step__title">{etape.titre[lang]}</h3>
        <p class="step__desc">{etape.description[lang]}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  /* ----- Résumé à droite du titre ----- */
  .summary__text {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .bar {
    height: 0.375rem;
    border-radius: var(--radius-pill);
    background: var(--border);
    overflow: hidden;
  }

  .bar__fill {
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }

  /* ----- Cartes des étapes : 6 colonnes, puis 3, puis 2 ----- */
  .steps {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.9rem;
    padding: 0;
    list-style: none;
  }

  .step {
    padding: 1.4rem 1.3rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card-lg);
  }

  .step__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
  }

  .step__num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .step__title {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
  }

  .step__desc {
    margin-top: 0.7rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* Étape en cours : bordure verte et fond légèrement teinté */
  .step--en-cours {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, var(--surface));
  }

  /* Étapes à venir : textes plus discrets */
  .step--a-venir .step__title {
    color: var(--text-secondary);
  }

  .step--a-venir .step__desc {
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .step {
      padding: 1.1rem 1rem 1.2rem;
    }

    .step__title {
      font-size: 1.125rem;
    }
  }
</style>
