---
// Section "Projets" : grille de cartes, toutes au même niveau, du plus récent au plus ancien.
// Au-delà de 6 projets, des filtres par domaine apparaissent.
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';
import { domaine, getProjets } from '../../lib/projets';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projets = await getProjets();

// Filtres seulement s'il y a plus de 6 projets : un bouton par domaine (sans doublon,
// dans l'ordre d'apparition). Le domaine FR sert d'identifiant, le libellé suit la langue.
const avecFiltres = projets.length > 6;
const domaines = [...new Map(projets.map((p) => [p.data.domaine, domaine(p, lang)]))];
---

<section id="projets" class="section container" aria-labelledby="projets-titre">
  <SectionHeading title={t('projects.title')} intro={t('projects.intro')} id="projets-titre">
    <!-- Filtres cachés tant que le JS n'a pas démarré : sans JS, tous les projets restent visibles -->
    {avecFiltres && (
      <div slot="aside" class="filters" role="group" aria-label={t('projects.filterLabel')} hidden>
        <button type="button" class="filter" data-filter="tous" aria-pressed="true">
          {t('projects.all')}
        </button>
        {domaines.map(([cle, libelle]) => (
          <button type="button" class="filter" data-filter={cle} aria-pressed="false">
            {libelle}
          </button>
        ))}
      </div>
    )}
  </SectionHeading>

  <div class="grid">
    {projets.map((projet) => (
      <ProjectCard projet={projet} lang={lang} />
    ))}
  </div>

  <!-- Annonce le nombre de projets affichés aux lecteurs d'écran -->
  <p class="sr-only" aria-live="polite" data-annonce={t('projects.shown')}></p>
</section>

<script>
  // Filtre des projets par domaine
  const section = document.querySelector('#projets');
  const filtres = section?.querySelector<HTMLElement>('.filters');

  if (section && filtres) {
    const boutons = filtres.querySelectorAll<HTMLButtonElement>('.filter');
    const cartes = section.querySelectorAll<HTMLElement>('[data-domaine]');
    const annonce = section.querySelector<HTMLElement>('[aria-live]');

    filtres.hidden = false; // le JS fonctionne : on affiche les filtres

    boutons.forEach((bouton) => {
      bouton.addEventListener('click', () => {
        const choix = bouton.dataset.filter;

        // Un seul bouton actif à la fois
        boutons.forEach((b) => b.setAttribute('aria-pressed', String(b === bouton)));

        // Affiche les cartes du domaine choisi (toutes si "tous")
        let nbVisibles = 0;
        cartes.forEach((carte) => {
          const visible = choix === 'tous' || carte.dataset.domaine === choix;
          carte.hidden = !visible;
          if (visible) nbVisibles++;
        });

        if (annonce) annonce.textContent = `${annonce.dataset.annonce} ${nbVisibles}`;
      });
    });
  }
</script>

<style>
  /* ----- Filtres ----- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .filter {
    padding: 0.45rem 1.05rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    font-size: 0.9375rem;
    color: var(--text-2);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .filter:hover {
    border-color: var(--muted);
    color: var(--text);
  }

  .filter[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  /* ----- Grille : 3 colonnes, puis 2, puis 1 ----- */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .filters {
      justify-content: flex-start;
    }
  }
</style>
