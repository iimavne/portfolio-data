---
// Section "À propos" : titre à gauche ; présentation, formation, expériences et langues à droite.
// Le contenu vient de src/data/apropos.ts ; les blocs vides sont masqués.
import SectionHeading from '../SectionHeading.astro';
import { experiences, formation, langues, presentation } from '../../data/apropos';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="a-propos" class="section container about" aria-labelledby="a-propos-titre">
  <SectionHeading title={t('about.title')} id="a-propos-titre" />

  <div class="about__content">
    <p class="about__intro">{presentation[lang]}</p>

    <h3 class="about__subtitle">{t('about.formation')}</h3>
    <ul class="formation">
      {formation.map((ligne) => (
        <li class="formation__row">
          <span class="formation__years">{ligne.annees}</span>
          <span class="formation__degree">{ligne.diplome[lang]}</span>
          <span class="formation__school">{ligne.etablissement}</span>
        </li>
      ))}
    </ul>

    <!-- Expériences : même présentation que la formation, plus une description -->
    {experiences.length > 0 && (
      <>
        <h3 class="about__subtitle">{t('about.experiences')}</h3>
        <ul class="formation">
          {experiences.map((ligne) => (
            <li class="formation__row">
              <span class="formation__years">{ligne.annees}</span>
              <span class="formation__degree">{ligne.poste[lang]}</span>
              {ligne.structure && <span class="formation__school">{ligne.structure}</span>}
              {ligne.description[lang] && <span class="formation__detail">{ligne.description[lang]}</span>}
            </li>
          ))}
        </ul>
      </>
    )}

    <!-- Langues : une pastille par langue -->
    {langues.length > 0 && (
      <>
        <h3 class="about__subtitle">{t('about.languages')}</h3>
        <ul class="languages">
          {langues.map((ligne) => (
            <li>
              <span class="languages__name">{ligne.langue[lang]}</span>
              {ligne.niveau[lang] && <span class="languages__level">{ligne.niveau[lang]}</span>}
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</section>

<style>
  /* Deux colonnes : titre (5 parts) | contenu (8 parts) */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    align-items: start; /* le titre reste en haut, aligné avec la présentation */
    gap: 2rem;
  }

  .about__intro {
    font-size: 1.3125rem;
    line-height: 1.55;
  }

  /* Petits titres mono des blocs : Formation, Expériences, Langues */
  .about__subtitle {
    margin-top: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ----- Liste de formation (et d'expériences) ----- */
  .formation {
    margin-top: 1rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  /* Chaque ligne : années | diplôme, avec l'établissement en dessous */
  .formation__row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.3rem 1.5rem;
    padding-block: 1.2rem;
    border-bottom: 1px solid var(--border);
  }

  .formation__years {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
  }

  .formation__degree {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .formation__school {
    grid-column: 2; /* sous le diplôme */
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  /* Description d'une expérience, sous la structure */
  .formation__detail {
    grid-column: 2;
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-2);
  }

  /* ----- Langues : pastilles "Anglais · C1" ----- */
  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .languages li {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.6rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
  }

  .languages__name {
    font-weight: 600;
  }

  .languages__level {
    color: var(--text-2);
  }

  /* ----- Tablette : une seule colonne ----- */
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  /* ----- Mobile : les 3 infos d'une ligne s'empilent ----- */
  @media (max-width: 600px) {
    .formation__row {
      grid-template-columns: 1fr;
    }

    .formation__school,
    .formation__detail {
      grid-column: auto;
    }
  }
</style>
