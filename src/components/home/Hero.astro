---
// Hero de l'accueil : qui est l'étudiant (formation, positionnement, domaines, langues)
// à gauche, ce qu'il recherche à droite. Tout vient de l'admin : Paramètres du site.
// Un bloc vide est masqué. Sur tablette et mobile (< 960px), l'encadré passe sous le texte.
import { profil, recherches, site } from '../../data/site';
import { localizePath, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { labelFormation, positionnement = site.name, accent, domaines, langues } = profil(lang);
const recherchesAffichees = recherches(lang);

// Titre coupé en trois morceaux pour mettre la partie choisie en couleur.
// Si elle n'est pas trouvée telle quelle dans le titre, tout reste en noir.
const position = accent ? positionnement.indexOf(accent) : -1;
const titre =
  accent && position >= 0
    ? { avant: positionnement.slice(0, position), accent, apres: positionnement.slice(position + accent.length) }
    : { avant: positionnement, accent: '', apres: '' };

// "Anglais : cours de M1..." en français, "English: courses..." en anglais
const separateur = lang === 'fr' ? ' : ' : ': ';
---

<section class="hero container">
  <div class="hero__text">
    {labelFormation && <p class="label">{labelFormation}</p>}

    <h1 class="hero__title">
      {titre.avant}{titre.accent && <span class="hero__accent">{titre.accent}</span>}{titre.apres}
    </h1>

    <!-- Domaines visés et langues : une ligne chacun, en pastilles -->
    {domaines.length > 0 && (
      <div class="hero__row">
        <p class="hero__row-label" id="hero-domaines">{t('hero.domains')}</p>
        <ul class="pills" aria-labelledby="hero-domaines">
          {domaines.map((domaine) => <li class="pill">{domaine}</li>)}
        </ul>
      </div>
    )}

    {langues.length > 0 && (
      <div class="hero__row">
        <p class="hero__row-label" id="hero-langues">{t('hero.languages')}</p>
        <ul class="pills" aria-labelledby="hero-langues">
          {langues.map((ligne) => (
            <li class:list={['pill', { 'pill--highlight': ligne.miseEnAvant }]}>
              {ligne.langue}{ligne.precision && `${separateur}${ligne.precision}`}
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="hero__actions">
      <a class="btn btn--accent btn--lg" href={localizePath('/#projets', lang)}>
        {t('hero.ctaProjects')}
        <!-- Flèche vers le bas -->
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M5 12l7 7 7-7" />
        </svg>
      </a>
      <a class="btn btn--lg hero__contact" href={localizePath('/#contact', lang)}>
        {t('hero.ctaContact')}
      </a>
    </div>
  </div>

  <!-- Encadré "Je recherche" : les recherches cochées "Afficher" dans l'admin -->
  {recherchesAffichees.length > 0 && (
    <aside class="search" aria-labelledby="search-title">
      <p class="search__title" id="search-title">
        <span class="search__dot" aria-hidden="true"></span>
        {t('search.title')}
      </p>
      <ul class="search__list">
        {recherchesAffichees.map((recherche) => (
          <li class="search__item">
            <p class="search__head">
              <span class="search__type">{t(`search.${recherche.type}`)}</span>
              {recherche.debut && <span class="search__start">{recherche.debut}</span>}
            </p>
            {recherche.details && <p class="search__details">{recherche.details}</p>}
          </li>
        ))}
      </ul>
    </aside>
  )}
</section>

<style>
  /* Deux colonnes : texte (prend la place restante) + encadré (~330px) */
  .hero {
    display: grid;
    grid-template-columns: 1fr minmax(0, 20.5rem);
    align-items: start;
    gap: 3rem 4rem;
    padding-block: 3.5rem 4rem;
  }

  /* ----- Texte ----- */
  .hero__title {
    max-width: 40rem;
    margin-block: 1rem 1.75rem;
    font-size: var(--fs-display); /* définie dans global.css */
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .hero__accent {
    color: var(--accent);
  }

  /* Une ligne "Domaines visés" / "Langues" : libellé à gauche, pastilles à droite */
  .hero__row {
    display: flex;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
  }

  .hero__row-label {
    flex: 0 0 7.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .pill {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  /* Langue mise en avant (ex. l'anglais) : bordure et fond légers en couleur d'accent */
  .pill--highlight {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__contact {
    background: var(--surface);
  }

  /* ----- Encadré "Je recherche" ----- */
  .search {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .search__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .search__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .search__list {
    padding: 0;
    list-style: none;
  }

  .search__item {
    padding: 1rem 1.25rem 1.1rem;
  }

  .search__item + .search__item {
    border-top: 1px solid var(--border);
  }

  .search__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .search__type {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .search__start {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }

  .search__details {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--text-2);
  }

  /* ----- Tablette et mobile : une seule colonne ----- */
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 2rem 3rem;
    }

    .search {
      max-width: 26rem;
    }
  }

  /* ----- Mobile : le libellé passe au-dessus des pastilles ----- */
  @media (max-width: 560px) {
    .hero__row {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 1rem;
    }

    .hero__row-label {
      flex-basis: auto;
    }
  }
</style>
