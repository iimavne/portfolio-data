---
// Section "Contact" : grand titre, formulaire de contact, boutons vers les profils.
// Aucune adresse email sur le site : les messages passent par Web3Forms, qui les
// transfère à l'adresse associée à la clé PUBLIC_WEB3FORMS_KEY (.env / Vercel).
// Les liens des profils viennent de src/data/site.ts.
import { site } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Clé Web3Forms, lue au build depuis .env (local) ou les variables Vercel.
// Absente : le formulaire est remplacé par un message "bientôt disponible".
const cleFormulaire = import.meta.env.PUBLIC_WEB3FORMS_KEY;

// Seuls les profils renseignés dans l'admin sont affichés
const profils = [
  { label: 'GitHub', href: site.links.github },
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'Kaggle', href: site.links.kaggle },
].filter((profil) => profil.href);
---

<section id="contact" class="section container" aria-labelledby="contact-titre">
  <p class="label" aria-hidden="true">// 05</p>

  <!-- Titre en deux morceaux : le 2e passe à la ligne -->
  <h2 class="contact__title" id="contact-titre">
    {t('contact.title')}
    <span class="contact__title-end">{t('contact.titleEnd')}</span>
  </h2>

  <!-- Formulaire (si la clé Web3Forms existe). Sans JS, il est envoyé directement
       à Web3Forms ; avec JS, il est envoyé en arrière-plan (voir le script plus bas) -->
  {cleFormulaire ? (
    <form
      class="form"
      action="https://api.web3forms.com/submit"
      method="POST"
      data-sending={t('form.sending')}
      data-success={t('form.success')}
      data-error={t('form.error')}
    >
      <input type="hidden" name="access_key" value={cleFormulaire} />
      <input type="hidden" name="subject" value={t('form.subject')} />
      <input type="hidden" name="from_name" value={site.name} />
      <!-- Piège à robots : invisible pour les humains, à laisser vide -->
      <input type="checkbox" name="botcheck" class="form__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="form__row">
        <div class="form__field">
          <label for="contact-nom">{t('form.name')}</label>
          <input id="contact-nom" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="form__field">
          <label for="contact-email">{t('form.email')}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            aria-describedby="contact-email-aide"
          />
          <p class="form__help" id="contact-email-aide">{t('form.emailHelp')}</p>
        </div>
      </div>

      <div class="form__field">
        <label for="contact-message">{t('form.message')}</label>
        <textarea id="contact-message" name="message" rows="6" required></textarea>
      </div>

      <div class="form__footer">
        <button type="submit" class="btn btn--accent btn--lg">{t('form.send')}</button>
        <!-- Résultat de l'envoi, annoncé par les lecteurs d'écran -->
        <p class="form__status" role="status" aria-live="polite"></p>
      </div>
    </form>
  ) : (
    <p class="contact__unavailable">{t('form.unavailable')}</p>
  )}

  <ul class="contact__links">
    {profils.map((profil) => (
      <li>
        <a class="btn" href={profil.href} target="_blank" rel="noopener noreferrer">
          {profil.label}<span class="sr-only"> {t('contact.newTab')}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  // Envoi du formulaire en arrière-plan, sans quitter la page
  const formulaire = document.querySelector<HTMLFormElement>('#contact .form');

  if (formulaire) {
    const bouton = formulaire.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const statut = formulaire.querySelector<HTMLElement>('.form__status')!;
    const texteBouton = bouton.textContent;

    formulaire.addEventListener('submit', async (event) => {
      event.preventDefault();
      bouton.disabled = true;
      bouton.textContent = formulaire.dataset.sending ?? '';
      statut.textContent = '';
      statut.classList.remove('is-error');

      try {
        const reponse = await fetch(formulaire.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(formulaire))),
        });
        const resultat = await reponse.json();
        if (!resultat.success) throw new Error(resultat.message);

        statut.textContent = formulaire.dataset.success ?? '';
        formulaire.reset();
      } catch {
        statut.textContent = formulaire.dataset.error ?? '';
        statut.classList.add('is-error');
      } finally {
        bouton.disabled = false;
        bouton.textContent = texteBouton;
      }
    });
  }
</script>

<style>
  .contact__title {
    margin-top: 1.75rem;
    font-size: var(--fs-display); /* même taille que le titre du hero */
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .contact__title-end {
    display: block;
  }

  .contact__unavailable {
    margin-top: 2.25rem;
    font-size: 1.125rem;
    color: var(--text-secondary);
  }

  /* ----- Formulaire ----- */
  .form {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
    margin-top: 2.5rem;
  }

  /* Nom et email côte à côte, puis l'un sous l'autre sur mobile */
  .form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .form__field {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  .form label {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .form input,
  .form textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    font-size: 1rem;
    color: var(--text);
    transition: border-color 0.15s;
  }

  .form textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .form input:hover,
  .form textarea:hover {
    border-color: var(--text-muted);
  }

  .form input:focus-visible,
  .form textarea:focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .form__help {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* Le piège à robots est sorti de l'écran (pas display: none, que certains robots repèrent) */
  .form__trap {
    position: absolute;
    left: -9999px;
  }

  .form__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .form button:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .form__status {
    font-size: 0.9375rem;
    color: var(--accent);
  }

  .form__status.is-error {
    color: #ff8a80;
  }

  /* ----- Profils ----- */
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }

  .contact__links .btn {
    padding: 0.8rem 1.35rem;
    font-size: 1rem;
  }

  @media (max-width: 640px) {
    .form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
