---
// Section "Contact" : grand titre, email en lien, boutons vers les profils.
// L'email et les liens viennent de src/data/site.ts.
import { site } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Seuls les profils renseignés dans l'admin sont affichés
const profils = [
  { label: 'GitHub', href: site.links.github },
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'Kaggle', href: site.links.kaggle },
].filter((profil) => profil.href);
---

<section id="contact" class="section container" aria-labelledby="contact-titre">
  <p class="label" aria-hidden="true">// 05</p>

  <!-- Titre en deux morceaux : le 2e passe à la ligne -->
  <h2 class="contact__title" id="contact-titre">
    {t('contact.title')}
    <span class="contact__title-end">{t('contact.titleEnd')}</span>
  </h2>

  <!-- mailto: ouvre la messagerie du visiteur -->
  <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>

  <ul class="contact__links">
    {profils.map((profil) => (
      <li>
        <a class="btn" href={profil.href} target="_blank" rel="noopener noreferrer">
          {profil.label}<span class="sr-only"> {t('contact.newTab')}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .contact__title {
    margin-top: 1.75rem;
    font-size: var(--fs-display); /* même taille que le titre du hero */
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .contact__title-end {
    display: block;
  }

  .contact__email {
    display: inline-block;
    margin-top: 2.25rem;
    font-size: clamp(1.5rem, 1rem + 2.4vw, 2.25rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere; /* un email long ne déborde pas sur mobile */
  }

  .contact__email:hover {
    text-decoration-thickness: 5px;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.25rem;
    padding: 0;
    list-style: none;
  }

  .contact__links .btn {
    padding: 0.8rem 1.35rem;
    font-size: 1rem;
  }
</style>
