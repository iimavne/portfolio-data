---
// Section "Contact" : titre, phrase d'accroche et profils à gauche, formulaire à droite.
// Aucune adresse email sur le site : les messages passent par Web3Forms, qui les
// transfère à l'adresse associée à la clé PUBLIC_WEB3FORMS_KEY (.env / Vercel).
// Les recherches et les liens des profils viennent de src/data/site.ts.
import { recherches, site } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Clé Web3Forms, lue au build depuis .env (local) ou les variables Vercel.
// Absente : le formulaire est remplacé par un message "bientôt disponible".
const cleFormulaire = import.meta.env.PUBLIC_WEB3FORMS_KEY;

// Phrase d'accroche construite à partir des recherches affichées dans le hero :
// "Un stage ou une alternance en data science à proposer ?". Sans recherche : phrase générique.
const offres = [...new Set(recherches(lang).map((recherche) => recherche.type))].map((type) =>
  t(`contact.offer.${type}`),
);
const enumeration =
  offres.length > 1 ? `${offres.slice(0, -1).join(', ')} ${t('contact.or')} ${offres.at(-1)}` : offres[0];
const accroche = enumeration
  ? `${enumeration.charAt(0).toUpperCase()}${enumeration.slice(1)} ${t('contact.offerEnd')}`
  : t('contact.generic');

// Seuls les profils renseignés dans l'admin sont affichés
const profils = [
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'GitHub', href: site.links.github },
].filter((profil) => profil.href);
---

<section id="contact" class="section container contact" aria-labelledby="contact-titre">
  <div class="contact__intro">
    <h2 class="contact__title" id="contact-titre">{t('contact.title')}</h2>
    <p class="contact__text">
      {accroche}<br />
      {t('contact.reply')}
    </p>

    {profils.length > 0 && (
      <ul class="contact__links">
        {profils.map((profil) => (
          <li>
            <a class="btn" href={profil.href} target="_blank" rel="noopener noreferrer">
              {profil.label}<span class="sr-only"> {t('contact.newTab')}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Formulaire (si la clé Web3Forms existe). Sans JS, il est envoyé directement
       à Web3Forms ; avec JS, il est envoyé en arrière-plan (voir le script plus bas) -->
  {cleFormulaire ? (
    <form
      class="form"
      action="https://api.web3forms.com/submit"
      method="POST"
      data-sending={t('form.sending')}
      data-success={t('form.success')}
      data-error={t('form.error')}
    >
      <input type="hidden" name="access_key" value={cleFormulaire} />
      <input type="hidden" name="subject" value={t('form.subject')} />
      <input type="hidden" name="from_name" value={site.name} />
      <!-- Piège à robots : invisible pour les humains, à laisser vide -->
      <input type="checkbox" name="botcheck" class="form__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="form__row">
        <div class="form__field">
          <label for="contact-nom">{t('form.name')}</label>
          <input id="contact-nom" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="form__field">
          <label for="contact-email">{t('form.email')}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            aria-describedby="contact-email-aide"
          />
          <p class="form__help" id="contact-email-aide">{t('form.emailHelp')}</p>
        </div>
      </div>

      <div class="form__field">
        <label for="contact-message">{t('form.message')}</label>
        <textarea id="contact-message" name="message" rows="4" required></textarea>
      </div>

      <div class="form__footer">
        <button type="submit" class="btn btn--accent">{t('form.send')}</button>
        <!-- Résultat de l'envoi, annoncé par les lecteurs d'écran -->
        <p class="form__status" role="status" aria-live="polite"></p>
      </div>
    </form>
  ) : (
    <p class="contact__unavailable">{t('form.unavailable')}</p>
  )}
</section>

<script>
  // Envoi du formulaire en arrière-plan, sans quitter la page
  const formulaire = document.querySelector<HTMLFormElement>('#contact .form');

  if (formulaire) {
    const bouton = formulaire.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const statut = formulaire.querySelector<HTMLElement>('.form__status')!;
    const texteBouton = bouton.textContent;

    formulaire.addEventListener('submit', async (event) => {
      event.preventDefault();
      bouton.disabled = true;
      bouton.textContent = formulaire.dataset.sending ?? '';
      statut.textContent = '';
      statut.classList.remove('is-error');

      try {
        const reponse = await fetch(formulaire.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(formulaire))),
        });
        const resultat = await reponse.json();
        if (!resultat.success) throw new Error(resultat.message);

        statut.textContent = formulaire.dataset.success ?? '';
        formulaire.reset();
      } catch {
        statut.textContent = formulaire.dataset.error ?? '';
        statut.classList.add('is-error');
      } finally {
        bouton.disabled = false;
        bouton.textContent = texteBouton;
      }
    });
  }
</script>

<style>
  /* Deux colonnes : texte et profils (place restante), formulaire (~430px) */
  .contact {
    display: grid;
    grid-template-columns: 1fr minmax(0, 27rem);
    align-items: start;
    gap: 2rem 4rem;
  }

  .contact__title {
    font-size: var(--fs-section);
    letter-spacing: -0.02em;
  }

  .contact__text {
    max-width: 26rem;
    margin-top: 0.75rem;
    color: var(--text-2);
  }

  .contact__unavailable {
    color: var(--text-2);
  }

  /* ----- Formulaire, dans une carte ----- */
  .form {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  /* Nom et email côte à côte, puis l'un sous l'autre sur mobile */
  .form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .form__field {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .form label {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .form input,
  .form textarea {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-2);
    font-size: 1rem; /* 16px minimum : évite le zoom automatique sur iPhone */
    color: var(--text);
    transition: border-color 0.15s;
  }

  .form textarea {
    resize: vertical;
    min-height: 6rem;
  }

  .form input:hover,
  .form textarea:hover {
    border-color: var(--muted);
  }

  .form input:focus-visible,
  .form textarea:focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .form__help {
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* Le piège à robots est sorti de l'écran (pas display: none, que certains robots repèrent) */
  .form__trap {
    position: absolute;
    left: -9999px;
  }

  .form__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .form button:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .form__status {
    font-size: 0.875rem;
    color: var(--accent);
  }

  .form__status.is-error {
    color: var(--danger);
  }

  /* ----- Profils ----- */
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .contact__links .btn {
    padding: 0.5rem 1rem;
    background: var(--surface);
    font-size: 0.875rem;
  }

  /* ----- Tablette et mobile : le formulaire passe sous le texte ----- */
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
