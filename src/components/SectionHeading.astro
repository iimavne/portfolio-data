---
// En-tête de section : titre et sous-titre optionnel.
// Un emplacement optionnel à droite (slot "aside") accueille un élément
// en plus, ex. les filtres de projets :
//   <SectionHeading title="Projets" intro="...">
//     <div slot="aside">...</div>
//   </SectionHeading>

interface Props {
  title: string;
  intro?: string;
  id?: string;      // id du titre, pour aria-labelledby sur la <section>
}

const { title, intro, id } = Astro.props;
---

<div class="heading">
  <div>
    <h2 class="heading__title" id={id}>{title}</h2>
    {intro && <p class="heading__intro">{intro}</p>}
  </div>
  {Astro.slots.has('aside') && (
    <div class="heading__aside">
      <slot name="aside" />
    </div>
  )}
</div>

<style>
  .heading {
    display: flex;
    flex-wrap: wrap; /* l'élément de droite passe dessous sur mobile */
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 3rem;
    margin-bottom: 1.75rem;
  }

  .heading__title {
    font-size: var(--fs-section);
    letter-spacing: -0.02em;
  }

  .heading__intro {
    margin-top: 0.375rem;
    color: var(--text-2);
  }

  .heading__aside {
    flex: 0 1 22.5rem;
  }
</style>
