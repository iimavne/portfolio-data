---
// Pied de page : copyright à gauche, lien vers les mentions légales à droite.
import { site } from '../data/site';
import { cheminTraduit, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Année calculée au moment de la génération du site
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p>© {year} {site.name}</p>
    <a class="footer__link" href={cheminTraduit('/mentions-legales/', lang)}>{t('footer.legal')}</a>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap; /* passe sur deux lignes sur mobile */
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .footer__link {
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }

  .footer__link:hover {
    color: var(--text);
  }
</style>
