---
// Carte d'un projet : zone haute (couverture, sinon le domaine écrit en grand),
// contexte, titre, résumé, outils, lien. Toute la carte est cliquable
// (le lien "Voir le projet" s'étend dessus).
import { Image } from 'astro:assets';
import { contexte, domaine, lienProjet, resume, titre, type Projet } from '../lib/projets';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  projet: Projet;
  lang: Lang;
}

const { projet, lang } = Astro.props;
const { data } = projet;
const t = useTranslations(lang);
const ligneContexte = contexte(projet, lang);
---

<!-- data-domaine sert au filtre JS de la section Projets (domaine FR = identifiant stable) -->
<article class="card" data-domaine={data.domaine}>
  <!-- Zone haute : décorative (le titre est juste en dessous), donc cachée aux lecteurs d'écran -->
  <div class="card__cover" aria-hidden="true">
    {data.image ? (
      <Image
        src={data.image}
        alt=""
        widths={[400, 800]}
        sizes="(max-width: 640px) 100vw, 370px"
        class="card__img"
      />
    ) : (
      <span class="card__domain">{domaine(projet, lang)}</span>
    )}
  </div>

  <div class="card__body">
    {ligneContexte && <p class="card__context">{ligneContexte}</p>}

    <h3 class="card__title">{titre(projet, lang)}</h3>
    <p class="card__resume">{resume(projet, lang)}</p>

    {data.outils.length > 0 && (
      <ul class="card__tools">
        {data.outils.map((outil) => <li>{outil}</li>)}
      </ul>
    )}

    <div class="card__footer">
      <!-- projet.id = nom du fichier .mdoc = adresse de la page -->
      <a class="card__link" href={lienProjet(projet.id, lang)}>
        {t('projects.view')}<span class="sr-only"> : {titre(projet, lang)}</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative; /* pour étendre le lien sur toute la carte */
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: var(--muted);
  }

  /* Contour clavier sur toute la carte quand le lien a le focus */
  .card:has(.card__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ----- Zone haute : image, ou domaine en grand sur fond secondaire ----- */
  .card__cover {
    display: flex;
    align-items: flex-end;
    height: 7.5rem;
    background: var(--surface-2);
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* l'image remplit le cadre sans se déformer */
  }

  .card__domain {
    padding: 0 1.25rem 0.9rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text-2);
  }

  /* ----- Contenu ----- */
  .card__body {
    display: flex;
    flex: 1; /* le pied de carte reste en bas, même si le résumé est court */
    flex-direction: column;
    padding: 1.1rem 1.25rem 1rem;
  }

  .card__context {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .card__title {
    margin-top: 0.5rem;
    font-size: 1.1875rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .card__resume {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-2);
  }

  .card__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
    padding: 0;
    list-style: none;
  }

  .card__tools li {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-2);
  }

  .card__footer {
    margin-top: auto; /* pousse le pied de carte tout en bas */
    padding-top: 1.25rem;
  }

  .card__link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }

  /* Le pseudo-élément couvre toute la carte : un clic n'importe où ouvre le projet */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:focus-visible {
    outline: none; /* le contour est porté par la carte (voir plus haut) */
  }
</style>
