---
// Carte d'un projet : couverture, catégorie + statut, titre, résumé, outils, lien.
// Toute la carte est cliquable (le lien "Voir le projet" s'étend dessus).
import { Image } from 'astro:assets';
import StatusBadge from './StatusBadge.astro';
import { categories } from '../data/projets';
import { resume, titre, type Projet } from '../lib/projets';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  projet: Projet;
  numero: string; // ex. "01"
  lang: Lang;
}

const { projet, numero, lang } = Astro.props;
const { data } = projet;
const t = useTranslations(lang);
---

<!-- data-categorie sert au filtre JS de la section Projets -->
<article class="card" data-categorie={data.categorie}>
  <!-- Couverture : image décorative (le titre est juste en dessous) -->
  <div class="card__cover">
    <Image
      src={data.image}
      alt=""
      widths={[400, 800]}
      sizes="(max-width: 640px) 100vw, 370px"
      class="card__img"
    />
    <span class="card__num" aria-hidden="true">{numero}</span>
    {data.miseEnAvant && <span class="card__featured">{t('projects.featured')}</span>}
  </div>

  <div class="card__body">
    <div class="card__meta">
      <span class="card__cat">{categories[data.categorie][lang]}</span>
      <StatusBadge statut={data.statut} lang={lang} />
    </div>

    <h3 class="card__title">{titre(projet, lang)}</h3>
    <p class="card__resume">{resume(projet, lang)}</p>

    <ul class="card__tools">
      {data.outils.map((outil) => <li>{outil}</li>)}
    </ul>

    <div class="card__footer">
      <!-- projet.id = nom du fichier .mdoc = adresse de la page -->
      <a class="card__link" href={localizePath(`/projets/${projet.id}`, lang)}>
        {t('projects.view')}<span class="sr-only"> : {titre(projet, lang)}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" />
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative; /* pour étendre le lien sur toute la carte */
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card-lg);
    transition: border-color 0.15s;
  }

  .card:hover {
    border-color: var(--text-muted);
  }

  /* Contour clavier sur toute la carte quand le lien a le focus */
  .card:has(.card__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ----- Couverture : image + numéro en surimpression ----- */
  .card__cover {
    position: relative;
    height: 11.25rem;
    background: #121418;
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* l'image remplit le cadre sans se déformer */
  }

  /* Dégradé sombre en bas pour que le numéro reste lisible sur une capture claire */
  .card__cover::after {
    content: '';
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(transparent, rgb(13 15 18 / 0.85));
  }

  .card__num {
    position: absolute;
    z-index: 1;
    bottom: 1rem;
    left: 1.2rem;
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
  }

  /* Badge "À la une", en haut à gauche de la couverture */
  .card__featured {
    position: absolute;
    z-index: 1;
    top: 1rem;
    left: 1.2rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--on-accent);
  }

  /* ----- Contenu ----- */
  .card__body {
    display: flex;
    flex: 1; /* le pied de carte reste en bas, même si le résumé est court */
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.25rem;
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .card__cat {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card__title {
    margin-top: 0.9rem;
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .card__resume {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .card__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block: 1.1rem 2.5rem; /* espace minimal avant le filet du bas */
    padding: 0;
    list-style: none;
  }

  .card__tools li {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .card__footer {
    display: flex;
    justify-content: flex-end;
    margin-top: auto; /* pousse le pied de carte tout en bas */
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  /* Le pseudo-élément couvre toute la carte : un clic n'importe où ouvre le projet */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:focus-visible {
    outline: none; /* le contour est porté par la carte (voir plus haut) */
  }
</style>
