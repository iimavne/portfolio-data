---
// Bouton rond clair / sombre, à côté du bouton de langue.
// Un clic passe au thème inverse et le choix est mémorisé dans ce navigateur.
// Tant que le visiteur n'a pas cliqué, le site suit le thème de son système.
// Le thème mémorisé est appliqué dès le chargement par le script en tête de BaseLayout.astro.
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<button
  type="button"
  class="theme"
  data-to-dark={t('theme.toDark')}
  data-to-light={t('theme.toLight')}
  aria-label={t('theme.toDark')}
  title={t('theme.toDark')}
>
  <!-- Lune en thème clair (passer au sombre), soleil en thème sombre (passer au clair) -->
  <svg class="theme__lune" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
  <svg class="theme__soleil" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<script>
  // Couleur de la barre du navigateur sur mobile, selon le thème
  const couleurs = { light: '#f6f5f1', dark: '#0e1013' } as const;
  const systemeSombre = window.matchMedia('(prefers-color-scheme: dark)');
  const boutons = document.querySelectorAll<HTMLButtonElement>('.theme');

  // Thème affiché : le choix du visiteur s'il y en a un, sinon celui du système
  const themeActuel = () =>
    (document.documentElement.dataset.theme as 'light' | 'dark' | undefined) ?? (systemeSombre.matches ? 'dark' : 'light');

  // Le libellé lu par les lecteurs d'écran décrit ce que fait le prochain clic
  const majLibelles = () => {
    const sombre = themeActuel() === 'dark';
    boutons.forEach((bouton) => {
      const libelle = (sombre ? bouton.dataset.toLight : bouton.dataset.toDark) ?? '';
      bouton.setAttribute('aria-label', libelle);
      bouton.title = libelle;
    });
  };

  boutons.forEach((bouton) =>
    bouton.addEventListener('click', () => {
      const nouveau = themeActuel() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = nouveau;
      try {
        localStorage.setItem('theme', nouveau);
      } catch {
        /* stockage indisponible : le choix vaut pour cette page seulement */
      }
      document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', couleurs[nouveau]));
      majLibelles();
    }),
  );

  systemeSombre.addEventListener('change', majLibelles);
  majLibelles();
</script>

<style>
  .theme {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.375rem;
    height: 2.375rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .theme:hover {
    border-color: var(--muted);
    color: var(--text);
  }

  /* Par défaut (thème clair) : la lune. En thème sombre : le soleil. */
  .theme__soleil {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme__lune {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme__soleil {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme__lune {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .theme__soleil {
      display: block;
    }
  }
</style>
